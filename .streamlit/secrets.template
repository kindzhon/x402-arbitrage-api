# Secrets template (DO NOT commit this file with real values)
# Copy this to secrets.toml and fill in your actual values

# Gateway 配置（必须）
OPENCLAW_GATEWAY_URL = "ws://your-server-ip:18789"
OPENCLAW_GATEWAY_TOKEN = "your-gateway-token-here"

# QQ Bot 配置（可选）
QQ_BOT_APP_ID = "your-qq-bot-app-id"
QQ_BOT_SECRET = "your-qq-bot-secret"

# 其他配置（可选）
# OPENCLAW_WORKSPACE = "/app/workspace"
